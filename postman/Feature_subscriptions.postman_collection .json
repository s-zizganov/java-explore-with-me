		{
			"name": "Получение событий подписок",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"/**",
							" * Подготавливает запрос для получения событий от подписок.",
							" */",
							"const prepareEventsRequest = async () => {",
							"    const api = new API(pm);",
							"    const util = new RandomUtils();",
							"    const ownerId = 2;",
							"    const subscriptionData = { ownerId: ownerId };",
							"    pm.request.body.update({",
							"        mode: 'raw',",
							"        raw: JSON.stringify(subscriptionData),",
							"        options: { raw: { language: 'json' } }",
							"    });",
							"    try {",
							"        const response = await pm.sendRequest({",
							"            url: `{{baseUrl}}/users/${userId}/subscriptions`,",
							"            method: 'GET'",
							"        });",
							"        const subscriptions = JSON.parse(response.body);",
							"        if (!Array.isArray(subscriptions)) {",
							"            console.error('Ожидался массив подписок, получено:', subscriptions);",
							"            return;",
							"        }",
							"    } catch (error) {",
							"        console.error('Ошибка при получении подписок:', error);",
							"    }",
							"};",
							"",
							"setTimeout(async () => {",
							"    try {",
							"        await prepareEventsRequest();",
							"    } catch (e) {",
							"        console.error('Ошибка подготовки:', e);",
							"    }",
							"}, 100);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"/**",
							" * Проверяет корректность ответа для событий подписок.",
							" */",
							"pm.test('Код ответа должен быть 200', () => {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Ответ должен быть массивом JSON', () => {",
							"    pm.response.to.be.json;",
							"    const response = pm.response.json();",
							"    pm.expect(Array.isArray(response)).to.be.true;",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
