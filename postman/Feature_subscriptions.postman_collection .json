		{
			"name": "Удаление подписки",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"/**",
							" * Подготавливает запрос для удаления подписки.",
							" */",
							"const userId = pm.collectionVariables.get('userId');",
							"pm.environment.set('userId', userId);",
							"const ownerId = pm.collectionVariables.get('ownerId');",
							"pm.environment.set('ownerId', ownerId);",
							"let requestOwnerId = pm.environment.get('ownerId');",
							"if (!requestOwnerId) {",
							"    requestOwnerId = '2';",
							"    pm.environment.set('ownerId', requestOwnerId);",
							"}",
							"console.log(`Удаление подписки пользователя ${userId} от пользователя ${ownerId}`);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
