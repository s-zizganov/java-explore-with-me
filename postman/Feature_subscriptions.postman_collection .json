	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"/**",
					" * Класс для выполнения API-запросов.",
					" */",
					"API = class {",
					"    constructor(postman, verbose = false, baseUrl = 'http://localhost:8080') {",
					"        this.baseUrl = baseUrl;",
					"        this.pm = postman;",
					"        this._verbose = verbose;",
					"    }",
					"",
					"    /**",
					"     * Создает нового пользователя.",
					"     * @param {Object} user - Данные пользователя.",
					"     * @param {boolean|null} verbose - Флаг логирования.",
					"     * @returns {Promise} Результат запроса.",
					"     */",
					"    async createUser(user, verbose = null) {",
					"        return this.post('/admin/users', user, 'Ошибка создания пользователя: ', verbose);",
					"    }",
					"",
					"    /**",
					"     * Создает новую категорию.",
					"     * @param {Object} category - Данные категории.",
					"     * @param {boolean|null} verbose - Флаг логирования.",
					"     * @returns {Promise} Результат запроса.",
					"     */",
					"    async createCategory(category, verbose = null) {",
					"        return this.post('/admin/categories', category, 'Ошибка создания категории: ', verbose);",
					"    }",
					"",
					"    /**",
					"     * Создает новое событие.",
					"     * @param {number} userId - ID пользователя.",
					"     * @param {Object} event - Данные события.",
					"     * @param {boolean|null} verbose - Флаг логирования.",
					"     * @returns {Promise} Результат запроса.",
					"     */",
					"    async createEvent(userId, event, verbose = null) {",
					"        return this.post(`/users/${userId}/events`, event, 'Ошибка создания события: ', verbose);",
					"    }",
					"",
					"    /**",
					"     * Создает новую подборку.",
					"     * @param {Object} compilation - Данные подборки.",
					"     * @param {boolean|null} verbose - Флаг логирования.",
					"     * @returns {Promise} Результат запроса.",
					"     */",
					"    async createCompilation(compilation, verbose = null) {",
					"        return this.post('/admin/compilations', compilation, 'Ошибка создания подборки: ', verbose);",
					"    }",
					"",
					"    /**",
					"     * Публикует запрос на участие в событии.",
					"     * @param {number} eventId - ID события.",
					"     * @param {number} userId - ID пользователя.",
					"     * @param {boolean|null} verbose - Флаг логирования.",
					"     * @returns {Promise} Результат запроса.",
					"     */",
					"    async publishParticipationRequest(eventId, userId, verbose = null) {",
					"        return this.post(`/users/${userId}/requests?eventId=${eventId}`, null, 'Ошибка публикации запроса на участие: ', verbose);",
					"    }",
					"",
					"    /**",
					"     * Публикует событие.",
					"     * @param {number} eventId - ID события.",
					"     * @param {boolean|null} verbose - Флаг логирования.",
					"     * @returns {Promise} Результат запроса.",
					"     */",
					"    async publishEvent(eventId, verbose = null) {",
					"        return this.patch(`/admin/events/${eventId}`, { stateAction: 'PUBLISH_EVENT' }, 'Ошибка публикации события: ', verbose);",
					"    }",
					"",
					"    /**",
					"     * Отклоняет событие.",
					"     * @param {number} eventId - ID события.",
					"     * @param {boolean|null} verbose - Флаг логирования.",
					"     * @returns {Promise} Результат запроса.",
					"     */",
					"    async rejectEvent(eventId, verbose = null) {",
					"        return this.patch(`/admin/events/${eventId}`, { stateAction: 'REJECT_EVENT' }, 'Ошибка отклонения события: ', verbose);",
					"    }",
					"",
					"    /**",
					"     * Подтверждает запрос на участие.",
					"     * @param {number} eventId - ID события.",
					"     * @param {number} userId - ID пользователя.",
					"     * @param {number} reqId - ID запроса.",
					"     * @param {boolean|null} verbose - Флаг логирования.",
					"     * @returns {Promise} Результат запроса.",
					"     */",
					"    async acceptParticipationRequest(eventId, userId, reqId, verbose = null) {",
					"        return this.patch(`/users/${userId}/events/${eventId}/requests`, { requestIds: [reqId], status: 'CONFIRMED' }, 'Ошибка подтверждения заявки: ', verbose);",
					"    }",
					"",
					"    /**",
					"     * Находит категорию по ID.",
					"     * @param {number} catId - ID категории.",
					"     * @param {boolean|null} verbose - Флаг логирования.",
					"     * @returns {Promise} Результат запроса.",
					"     */",
					"    async findCategory(catId, verbose = null) {",
					"        return this.get(`/categories/${catId}`, null, 'Ошибка поиска категории: ', verbose);",
					"    }",
					"",
					"    /**",
					"     * Находит подборку по ID.",
					"     * @param {number} compId - ID подборки.",
					"     * @param {boolean|null} verbose - Флаг логирования.",
					"     * @returns {Promise} Результат запроса.",
					"     */",
					"    async findCompilation(compId, verbose = null) {",
					"        return this.get(`/compilations/${compId}`, null, 'Ошибка поиска подборки: ', verbose);",
					"    }",
					"",
					"    /**",
					"     * Находит событие по ID.",
					"     * @param {number} eventId - ID события.",
					"     * @param {boolean|null} verbose - Флаг логирования.",
					"     * @returns {Promise} Результат запроса.",
					"     */",
					"    async findEvent(eventId, verbose = null) {",
					"        return this.get(`/events/${eventId}`, null, 'Ошибка поиска события: ', verbose);",
					"    }",
					"",
					"    /**",
					"     * Находит пользователя по ID.",
					"     * @param {number} userId - ID пользователя.",
					"     * @param {boolean|null} verbose - Флаг логирования.",
					"     * @returns {Promise} Результат запроса.",
					"     */",
					"    async findUser(userId, verbose = null) {",
					"        return this.get(`/admin/users?ids=${userId}`, null, 'Ошибка поиска пользователя: ', verbose);",
					"    }",
					"",
					"    /**",
					"     * Выполняет POST-запрос.",
					"     * @param {string} path - Путь запроса.",
					"     * @param {Object} body - Тело запроса.",
					"     * @param {string} errorText - Текст ошибки.",
					"     * @param {boolean|null} verbose - Флаг логирования.",
					"     * @returns {Promise} Результат запроса.",
					"     */",
					"    async post(path, body, errorText = 'Ошибка POST-запроса: ', verbose = null) {",
					"        return this.sendRequest('POST', path, body, errorText, verbose);",
					"    }",
					"",
					"    /**",
					"     * Выполняет PATCH-запрос.",
					"     * @param {string} path - Путь запроса.",
					"     * @param {Object} body - Тело запроса.",
					"     * @param {string} errorText - Текст ошибки.",
					"     * @param {boolean|null} verbose - Флаг логирования.",
					"     * @returns {Promise} Результат запроса.",
					"     */",
					"    async patch(path, body = null, errorText = 'Ошибка PATCH-запроса: ', verbose = null) {",
					"        return this.sendRequest('PATCH', path, body, errorText, verbose);",
					"    }",
					"",
					"    /**",
					"     * Выполняет GET-запрос.",
					"     * @param {string} path - Путь запроса.",
					"     * @param {Object} body - Тело запроса.",
					"     * @param {string} errorText - Текст ошибки.",
					"     * @param {boolean|null} verbose - Флаг логирования.",
					"     * @returns {Promise} Результат запроса.",
					"     */",
					"    async get(path, body = null, errorText = 'Ошибка GET-запроса: ', verbose = null) {",
					"        return this.sendRequest('GET', path, body, errorText, verbose);",
					"    }",
					"",
					"    /**",
					"     * Добавляет комментарий к событию.",
					"     * @param {number} userId - ID пользователя.",
					"     * @param {number} eventId - ID события.",
					"     * @param {Object} comment - Данные комментария.",
					"     * @param {boolean|null} verbose - Флаг логирования.",
					"     * @returns {Promise} Результат запроса.",
					"     */",
					"    async addComment(userId, eventId, comment, verbose = null) {",
					"        return this.post(`/users/${userId}/comments?eventId=${eventId}`, comment, 'Ошибка добавления комментария: ', verbose);",
					"    }",
					"",
					"    /**",
					"     * Выполняет HTTP-запрос.",
					"     * @param {string} method - HTTP-метод.",
					"     * @param {string} path - Путь запроса.",
					"     * @param {Object} body - Тело запроса.",
					"     * @param {string} errorText - Текст ошибки.",
					"     * @param {boolean|null} verbose - Флаг логирования.",
					"     * @returns {Promise} Результат запроса.",
					"     */",
					"    async sendRequest(method, path, body = null, errorText = 'Ошибка запроса: ', verbose = null) {",
					"        return new Promise((resolve, reject) => {",
					"            verbose = verbose == null ? this._verbose : verbose;",
					"            const request = {",
					"                url: this.baseUrl + path,",
					"                method: method,",
					"                body: body == null ? '' : JSON.stringify(body),",
					"                header: { 'Content-Type': 'application/json' }",
					"            };",
					"            if (verbose) {",
					"                console.log('Отправка запроса:', request);",
					"            }",
					"            try {",
					"                this.pm.sendRequest(request, (error, response) => {",
					"                    if (error || (response.code >= 400 && response.code <= 599)) {",
					"                        let err = error ? error : JSON.stringify(response.json());",
					"                        console.error('Ошибка при выполнении запроса:\\n', err,",
					"                            '\\nДля отладки повторите запрос локально. Данные:\\n', JSON.stringify(request));",
					"                        reject(new Error(errorText + err));",
					"                    }",
					"                    if (verbose) {",
					"                        console.log('Результат запроса: код', response.code, ', тело:', response.json());",
					"                    }",
					"                    if (response.stream.length === 0) {",
					"                        reject(new Error('Получено пустое тело ответа'));",
					"                    } else {",
					"                        resolve(response.json());",
					"                    }",
					"                });",
					"            } catch (err) {",
					"                if (verbose) {",
					"                    console.error(errorText, err);",
					"                }",
					"                return Promise.reject(err);",
					"            }",
					"        });",
					"    }",
					"};",
					"",
					"/**",
					" * Класс для генерации случайных данных.",
					" */",
					"RandomUtils = class {",
					"    constructor() {}",
					"",
					"    /**",
					"     * Генерирует данные пользователя.",
					"     * @returns {Object} Данные пользователя.",
					"     */",
					"    generateUser() {",
					"        return {",
					"            name: pm.variables.replaceIn('{{$randomFullName}}'),",
					"            email: pm.variables.replaceIn('{{$randomEmail}}')",
					"        };",
					"    }",
					"",
					"    /**",
					"     * Генерирует данные комментария.",
					"     * @returns {Object} Данные комментария.",
					"     */",
					"    generateComment() {",
					"        return {",
					"            text: pm.variables.replaceIn('{{$randomLoremSentence}}') + ' ' + this.generateWord(5)",
					"        };",
					"    }",
					"",
					"    /**",
					"     * Генерирует данные категории.",
					"     * @returns {Object} Данные категории.",
					"     */",
					"    generateCategory() {",
					"        return {",
					"            name: pm.variables.replaceIn('{{$randomWord}}') + Math.floor(Math.random() * 10000 * Math.random()).toString()",
					"        };",
					"    }",
					"",
					"    /**",
					"     * Генерирует данные события.",
					"     * @param {number} categoryId - ID категории.",
					"     * @returns {Object} Данные события.",
					"     */",
					"    generateEvent(categoryId) {",
					"        return {",
					"            annotation: pm.variables.replaceIn('{{$randomLoremParagraph}}'),",
					"            category: categoryId,",
					"            description: pm.variables.replaceIn('{{$randomLoremParagraphs}}'),",
					"            eventDate: this.generateFutureDateTime(),",
					"            location: {",
					"                lat: parseFloat(pm.variables.replaceIn('{{$randomLatitude}}')),",
					"                lon: parseFloat(pm.variables.replaceIn('{{$randomLongitude}}'))",
					"            },",
					"            paid: pm.variables.replaceIn('{{$randomBoolean}}'),",
					"            participantLimit: pm.variables.replaceIn('{{$randomInt}}'),",
					"            requestModeration: pm.variables.replaceIn('{{$randomBoolean}}'),",
					"            title: pm.variables.replaceIn('{{$randomLoremSentence}}')",
					"        };",
					"    }",
					"",
					"    /**",
					"     * Генерирует данные подборки.",
					"     * @param {...number} eventIds - ID событий.",
					"     * @returns {Object} Данные подборки.",
					"     */",
					"    generateCompilation(...eventIds) {",
					"        return {",
					"            title: pm.variables.replaceIn('{{$randomLoremSentence}}').slice(0, 50),",
					"            pinned: pm.variables.replaceIn('{{$randomBoolean}}'),",
					"            events: eventIds",
					"        };",
					"    }",
					"",
					"    /**",
					"     * Генерирует будущую дату и время.",
					"     * @param {number} hourShift - Смещение часов.",
					"     * @param {number} minuteShift - Смещение минут.",
					"     * @param {number} yearShift - Смещение лет.",
					"     * @returns {string} Форматированная дата.",
					"     */",
					"    generateFutureDateTime(hourShift = 5, minuteShift = 0, yearShift = 0) {",
					"        let moment = require('moment');",
					"        let m = moment();",
					"        m.add(hourShift, 'hour');",
					"        m.add(minuteShift, 'minute');",
					"        m.add(yearShift, 'year');",
					"        return m.format('YYYY-MM-DD HH:mm:ss');",
					"    }",
					"",
					"    /**",
					"     * Генерирует случайное слово.",
					"     * @param {number} length - Длина слова.",
					"     * @returns {string} Случайное слово.",
					"     */",
					"    generateWord(length = 1) {",
					"        let result = '';",
					"        const characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';",
					"        const charactersLength = characters.length;",
					"        let counter = 0;",
					"        while (counter < length) {",
					"            result += characters.charAt(Math.floor(Math.random() * charactersLength));",
					"            counter += 1;",
					"        }",
					"        return result;",
					"    }",
					"}"
				]
			}
		},
