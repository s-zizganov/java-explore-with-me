	"item": [
		{
			"name": "Создание подписки",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"/**",
							" * Подготавливает данные для запроса на создание подписки.",
							" */",
							"const setupRequest = async () => {",
							"    const api = new API(pm);",
							"    const util = new RandomUtils();",
							"    let subscriptionData;",
							"    try {",
							"        const user = await api.createUser(util.generateUser());",
							"        pm.collectionVariables.set('uid', user.id);",
							"        const category = await api.createCategory(util.generateCategory());",
							"        subscriptionData = util.generateEvent(category.id);",
							"        subscriptionData.ownerId = 2;",
							"    } catch (err) {",
							"        console.error('Ошибка при подготовке данных:', err);",
							"    }",
							"    pm.request.body.update({",
							"        mode: 'raw',",
							"        raw: JSON.stringify(subscriptionData),",
							"        options: { raw: { language: 'json' } }",
							"    });",
							"    console.log('Тело запроса:', pm.request.body.raw);",
							"};",
							"",
							"setTimeout(async () => {",
							"    try {",
							"        await setupRequest();",
							"    } catch (e) {",
							"        console.error('Ошибка в функции подготовки:', e);",
							"    }",
							"}, 100);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"/**",
							" * Проверяет успешность создания подписки.",
							" */",
							"pm.test('Код ответа должен быть 201', () => {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('Заголовок Content-Type должен быть application/json', () => {",
							"    pm.response.to.have.header('Content-Type', 'application/json');",
							"});",
							"",
							"pm.test('Ответ содержит поле id', () => {",
							"    const response = pm.response.json();",
							"    pm.expect(response).to.have.property('id');",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/users/{{userId}}/subscriptions",
					"host": [
